# Copia este archivo a `.env` en esta misma carpeta. `.env` está ignorado por
# git; este ejemplo no lleva secretos reales y no debe llevarlos nunca.
#
# Los valores de aquí son los del entorno local. En nube, el mismo compose se
# levanta con otro `.env` y sin pgAdmin (docs/Despliegue_y_operacion.md §3).

# ---------- PostgreSQL ----------
# `postgres` es solo para administración: la aplicación y Flyway usan `vetcat`.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-no-usar-en-nube
# Si la máquina ya tiene un PostgreSQL escuchando en 5432, cambia este valor.
POSTGRES_PORT=5432

VETCAT_DB=vetcat_db
VETCAT_DB_USER=vetcat
VETCAT_DB_PASSWORD=local-vetcat-no-usar-en-nube

KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-no-usar-en-nube

# ---------- Keycloak ----------
KEYCLOAK_PORT=8080
# Puerto de management (salud y métricas).
KEYCLOAK_MANAGEMENT_PORT=9002
# Usuario administrador del realm, solo para la consola de Keycloak.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-no-usar-en-nube

# ---------- Correo de pruebas (solo desarrollo, issue #108) ----------
# UI web de Mailpit para leer los correos capturados: http://localhost:8025
MAILPIT_UI_PORT=8025
# Remitente con el que Keycloak envía recuperaciones e invitaciones.
KEYCLOAK_SMTP_FROM=no-reply@vetcat.dev

# ---------- Clientes del realm `vetcat` (issue #149, ADR-0004) ----------
# `redirect_uri` de la app Android (cliente público `vetcat-app`).
VETCAT_APP_REDIRECT_URI=vetcat://callback
# Origen de la consola Flutter Web (cliente público `vetcat-admin`). Es su
# Web Origin para CORS y la base de su `redirect_uri` (`/admin/callback`).
VETCAT_ADMIN_ORIGIN=http://localhost:8081

# ---------- API (se ejecuta en el host; el compose todavía no la levanta) ----------
# Clave HMAC para firmar el token de tenant. Obligatoria y de 32 bytes o más:
# la API no arranca sin ella. Expórtala en la terminal donde corras bootRun.
VETCAT_TOKEN_CLAVE=cambia-esto-por-una-clave-local-de-32-bytes-o-mas

# ---------- pgAdmin (perfil `admin`, nunca en nube) ----------
PGADMIN_PORT=5050
# pgAdmin rechaza dominios reservados como `.local` al validar el correo.
PGADMIN_DEFAULT_EMAIL=admin@vetcat.dev
PGADMIN_DEFAULT_PASSWORD=local-pgadmin-no-usar-en-nube
