# Copia este archivo a `.env` en esta misma carpeta. `.env` está ignorado por
# git; este ejemplo no lleva secretos reales y no debe llevarlos nunca.
#
# Los valores de aquí son los del entorno local. En nube, el mismo compose se
# levanta con otro `.env` y sin pgAdmin (docs/Despliegue_y_operacion.md §3).

# ---------- PostgreSQL ----------
# `postgres` es solo para administración: la aplicación y Flyway usan `vetcat`.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-no-usar-en-nube
# Si la máquina ya tiene un PostgreSQL escuchando en 5432, cambia este valor.
POSTGRES_PORT=5432

VETCAT_DB=vetcat_db
VETCAT_DB_USER=vetcat
VETCAT_DB_PASSWORD=local-vetcat-no-usar-en-nube

KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-no-usar-en-nube

# ---------- Keycloak ----------
KEYCLOAK_PORT=8080
# Puerto de management (salud y métricas). No puede ser 9000: es el de RustFS.
KEYCLOAK_MANAGEMENT_PORT=9002
# Usuario administrador del realm, solo para la consola de Keycloak.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-no-usar-en-nube

# ---------- Almacenamiento de adjuntos (compatible con S3, ADR-0005) ----------
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=vetcat
RUSTFS_SECRET_KEY=local-rustfs-no-usar-en-nube
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=vetcat-adjuntos

# ---------- pgAdmin (perfil `admin`, nunca en nube) ----------
PGADMIN_PORT=5050
# pgAdmin rechaza dominios reservados como `.local` al validar el correo.
PGADMIN_DEFAULT_EMAIL=admin@vetcat.dev
PGADMIN_DEFAULT_PASSWORD=local-pgadmin-no-usar-en-nube
